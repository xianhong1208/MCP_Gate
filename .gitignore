# --- Local secrets: environment files stay on the machine that made them ---
.env
.env.local
.env.*.local

# --- Python bytecode, packaging and build output ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtualenvs (uv creates .venv/) ---
.venv/
venv/
ENV/

# --- Editor and IDE state ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Test runners and coverage reports ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Log output ---
logs/
*.log

# --- Local database files (SQLite) ---
*.db
*.sqlite3

# --- Console frontend: dependencies, Vite output, local env ---
frontend/node_modules/
frontend/dist/
frontend/.env

# --- Packaged deployment output ---
MCP_Gate_Deployed

# --- Key material ---
keys/
*.lic
license_private.pem

# --- OS metadata and stray packaging artifacts ---
.DS_Store
Thumbs.db
artifact/

# --- Marketplace image tarballs for offline installs are too large for git;
#     only the README in that folder is tracked ---
catalog/images/*
!catalog/images/README.md

# --- Scratch config left behind by local test runs ---
config/test_config.yaml

# --- Runtime state: SQLite database, and the secrets generated on first start (kept apart, #29) ---
data/
/secrets/

# --- Screenshots and browser-automation leftovers in the repo root ---
/*.png
.playwright-mcp/

# --- Claude Code per-machine settings ---
.claude/
