# MCP Gate environment variables
# cp .env.example .env
#
# Everything may be left empty: SQLite is used by default and keys are generated and stored in secrets/secrets.json.
# Only for a public deployment must OAUTH_ISSUER be changed to the public URL.

# ---- Database (SQLite by default; PostgreSQL example: postgresql://user:pwd@localhost/mcp_gate) ----
# DATABASE_URL=sqlite:///data/mcp_gate.db

# ---- Public URL (the only setting that really needs a look) ----
# Written into the iss of every token; MCP servers / clients use it for discovery. The app binds this port directly.
#   Local only:                    http://localhost:4568
#   Other machines on the LAN:     http://192.168.1.10:4568
#   Reverse proxy / domain:        https://mcp.yourdomain.com (binds 4568 here; nginx forwards to it)
OAUTH_ISSUER=http://localhost:4568
# OAUTH_ACCESS_EXPIRE_MINUTES=60
# OAUTH_REFRESH_EXPIRE_DAYS=30
# OAUTH_DCR_AUTO_APPROVE=true
# Signing keys rotate every N days (0 = only by hand); a new key is published this many minutes before it signs
# OAUTH_SIGNING_KEY_ROTATION_DAYS=90
# OAUTH_SIGNING_KEY_PREPUBLISH_MINUTES=1440
# Client ID Metadata Documents: MCP clients may use an https URL as client_id (no registration needed)
# OAUTH_CIMD_ENABLED=true
# OAUTH_CIMD_AUTO_APPROVE=true
# Only accept client_id URLs on these hosts (comma-separated, "*.example.com" for subdomains); empty = any
# OAUTH_CIMD_ALLOWED_HOSTS=
# Development / intranet only: hosts whose metadata may be fetched from private addresses
# OAUTH_CIMD_PRIVATE_NETWORK_HOSTS=

# ---- Secrets (leave empty to generate and persist them in secrets/secrets.json) ----
# Admin console session cookie signing
# SESSION_SECRET_KEY=
# Encryption at rest (private keys, service tokens, container env): never change it once set
# ENCRYPTION_KEY=
# Rotate it with `python -m src.cli encryption-key rotate`. For a key kept here: set the new one above, the old one
# below (comma-separated), restart, then run the command; drop this line when it says so.
# ENCRYPTION_KEYS_PREVIOUS=
# Where generated secrets are kept (default secrets/, apart from data/; back it up separately)
# MCP_GATE_SECRETS_DIR=secrets

# ---- Owner account created automatically on first start (if unset, open http://localhost:4568/setup and paste
#      the setup token from the startup log, or SETUP_TOKEN in secrets/secrets.json) ----
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me
# MCP_GATE_SETUP_TOKEN=               # pin the setup token instead of reading it from the log

# ---- Admin console third-party login providers (optional; only shown on the login page when filled in) ----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Other ----
# Directory holding the five config files (database, oauth, identity, security, system .yaml)
# MCP_GATE_CONFIG_DIR=config
# LOG_LEVEL=INFO
# LOG_FORMAT=colorized                 # or json: one object per line, for log collectors
# LOG_DIR=logs                         # empty = console only, no files (the Docker image's default)
# SECURE_COOKIE=false
# ENABLE_API_DOCS=true
# Advanced: set only when the bind address / port must differ from OAUTH_ISSUER
# (e.g. listening on localhost only behind a reverse proxy)
# SERVER_HOST=0.0.0.0
# SERVER_PORT=4568

# Managed servers (Marketplace / bring-your-own): how they run.
#   docker  - sibling containers via the Docker SDK (default)
#   process - local subprocesses bridged by supergateway; no Docker, bring-your-own servers only
#   auto    - docker when the daemon answers, else process
# MCP_RUNTIME=docker
# MCP_SUPERGATEWAY_BIN=supergateway
# MCP_PROCESS_LOG_DIR=data/managed

# ---- Docker Compose (docker-compose.yml) ----
# MCP_GATE_VERSION=latest              # pin a release of tonyhuang1101/mcp-gate, e.g. 1.4.0
# MCP_GATE_PORT=4568                   # the host port; OAUTH_ISSUER must use it
# With --profile postgres: DATABASE_URL=postgresql://mcpgate:<POSTGRES_PASSWORD>@postgres:5432/mcp_gate
# POSTGRES_PASSWORD=
